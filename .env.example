# Copie para .env e preencha. O .env nunca é versionado.

# ---------------------------------------------------------------------------
# Admin (/admin) — usado SOMENTE no servidor (login + gravação do catálogo)
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=troque-uma-senha-forte

# ---------------------------------------------------------------------------
# Loja Tray — usada no navegador para montar links de carrinho/checkout
# VITE_TRAY_BASE_URL: domínio da loja, sem barra no final (ex.: https://sualoja.com.br)
# VITE_TRAY_LOJA_ID:  id da loja Tray (aparece em /loja/cartService.php?loja=XXXXX)
# ---------------------------------------------------------------------------
VITE_TRAY_BASE_URL=
VITE_TRAY_LOJA_ID=
